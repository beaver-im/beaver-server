syntax = "v1"

// 队间文件记录面（S2S）。对外上传见 file_public.api（第三平面）。

type (
	SaveFileReq {
		OriginalName string `json:"originalName,optional"` // 原始文件名
		Size         int64  `json:"size,optional"`         // 文件大小
		Path         string `json:"path,optional"`         // 存储路径
		Md5          string `json:"md5,optional"`          // MD5
		Type         string `json:"type,optional"`         // 文件类型
		Source       string `json:"source,optional"`       // 来源
		FileInfoJson string `json:"fileInfoJson,optional"` // 文件附加信息 JSON
	}

	SaveFileRes {
		FileKey string `json:"fileKey,optional"` // 文件Key
	}
)

type (
	FileItem {
		ID           uint64 `json:"id,optional"`
		FileKey      string `json:"fileKey,optional"`
		OriginalName string `json:"originalName,optional"`
		Size         int64  `json:"size,optional"`
		Path         string `json:"path,optional"`
		Md5          string `json:"md5,optional"`
		Type         string `json:"type,optional"`
		Source       string `json:"source,optional"`
		CreatedAt    string `json:"createdAt,optional"`
		UpdatedAt    string `json:"updatedAt,optional"`
	}

	ListFilesReq {
		Page     int32  `json:"page,optional"`
		PageSize int32  `json:"pageSize,optional"`
		Type     string `json:"type,optional"`
		Keywords string `json:"keywords,optional"`
	}

	ListFilesRes {
		Total int64      `json:"total,optional"`
		List  []FileItem `json:"list,optional"`
	}
)

type (
	DeleteFileReq {
		ID uint64 `json:"id,optional"`
	}

	DeleteFileRes {
		Path string `json:"path,optional"`
	}
)

type (
	BatchDeleteFilesReq {
		IDs []uint64 `json:"ids,optional"`
	}

	BatchDeleteFilesRes {
		Paths []string `json:"paths,optional"`
	}
)

type (
	GetFileByIdReq {
		ID uint64 `json:"id,optional"`
	}

	GetFileByIdRes {
		File *FileItem `json:"file,optional"`
	}
)

type (
	GetFileByMd5Req {
		Md5 string `json:"md5,optional"`
	}

	GetFileByMd5Res {
		File *FileItem `json:"file,optional"`
	}
)

type (
	GetFileDetailReq {
		FileKey string `json:"fileKey,optional"`
	}

	GetFileDetailRes {
		FileKey      string `json:"fileKey,optional"`
		OriginalName string `json:"originalName,optional"`
		Size         int64  `json:"size,optional"`
		Path         string `json:"path,optional"`
		Md5          string `json:"md5,optional"`
		Type         string `json:"type,optional"`
		CreatedAt    string `json:"createdAt,optional"`
		UpdatedAt    string `json:"updatedAt,optional"`
	}
)

@server (
	group: file
	middleware: JwtS2s
)
service asset {
	@doc "队间：登记文件记录"
	@handler FileSave
	post /beaver/api/asset/file/v1/save (SaveFileReq) returns (SaveFileRes)

	@doc "队间：分页查询文件记录"
	@handler FileList
	post /beaver/api/asset/file/v1/list (ListFilesReq) returns (ListFilesRes)

	@doc "队间：删除单个文件记录"
	@handler FileDelete
	post /beaver/api/asset/file/v1/delete (DeleteFileReq) returns (DeleteFileRes)

	@doc "队间：批量删除文件记录"
	@handler FileBatchDelete
	post /beaver/api/asset/file/v1/batch_delete (BatchDeleteFilesReq) returns (BatchDeleteFilesRes)

	@doc "队间：按记录ID取文件"
	@handler FileById
	post /beaver/api/asset/file/v1/detail (GetFileByIdReq) returns (GetFileByIdRes)

	@doc "队间：按MD5取文件"
	@handler FileByMd5
	post /beaver/api/asset/file/v1/by_md5 (GetFileByMd5Req) returns (GetFileByMd5Res)

	@doc "队间：按文件Key取详情"
	@handler FileDetailByKey
	post /beaver/api/asset/file/v1/detail_by_key (GetFileDetailReq) returns (GetFileDetailRes)
}
