syntax = "v1"

// 离线推送：入队 im.offline.push，由同进程 OfflineWorker 集群消费。
// Res.Accepted 只表示 MQ 已接收，不等于已送达客户端；幂等键 messageID 由调用方传入。

type (
	PushOfflineReq {
		UserID         string            `json:"userId"`
		Title          string            `json:"title"`
		Body           string            `json:"body"`
		Data           map[string]string `json:"data,optional"`
		ConversationID string            `json:"conversationId,optional"`
		IsMuted        bool              `json:"isMuted"`
		MessageID      string            `json:"messageId"`
	}

	PushOfflineRes {
		Accepted bool `json:"accepted"`
	}
)

@server (
	group: offline
	middleware: JwtS2s
)
service push {
	@doc "离线厂商推送任务入队"
	@handler pushOffline
	post /beaver/api/push/offline/v1/push_offline (PushOfflineReq) returns (PushOfflineRes)
}
